<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Twin Palms Insurance Group provides personalized home, auto, flood, and business insurance throughout St. Augustine and nearby Florida communities.">
  <meta name="theme-color" content="#11110f">
  <title>Twin Palms Insurance Group | St. Augustine Insurance</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet">

  <style>
    :root {
      --gold: #f5b84b;
      --gold-deep: #d99827;
      --gold-pale: #fff2d7;
      --ink: #336699;
      --charcoal: #24231f;
      --sand: #f6f1e8;
      --cream: #fffdf8;
      --white: #ffffff;
      --muted: #6e6a61;
      --line: rgba(17, 17, 15, 0.12);
      --shadow-sm: 0 12px 35px rgba(25, 22, 15, 0.08);
      --shadow-lg: 0 28px 80px rgba(25, 22, 15, 0.18);
      --radius-sm: 14px;
      --radius-md: 24px;
      --radius-lg: 36px;
      --container: 1200px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
      scroll-padding-top: 110px;
    }

    body {
      overflow-x: hidden;
      background: var(--cream);
      color: var(--ink);
      font-family: "DM Sans", sans-serif;
      line-height: 1.65;
      -webkit-font-smoothing: antialiased;
    }

    body.menu-open {
      overflow: hidden;
    }

    img {
      display: block;
      width: 100%;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button,
    input,
    select,
    textarea {
      font: inherit;
    }

    button {
      border: 0;
      cursor: pointer;
    }

    .container {
      width: min(calc(100% - 40px), var(--container));
      margin-inline: auto;
    }

    .section {
      padding: 110px 0;
    }

    .section-kicker {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 18px;
      color: var(--gold-deep);
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }

    .section-kicker::before {
      width: 30px;
      height: 2px;
      background: currentColor;
      content: "";
    }

    h1,
    h2,
    h3,
    .brand-name {
      font-family: "Playfair Display", serif;
      line-height: 1.08;
    }

    h1 {
      max-width: 850px;
      color: var(--white);
      font-size: clamp(3rem, 6.4vw, 6.6rem);
      font-weight: 600;
      letter-spacing: -0.045em;
    }

    h2 {
      font-size: clamp(2.35rem, 4.5vw, 4.4rem);
      font-weight: 600;
      letter-spacing: -0.035em;
    }

    h3 {
      font-size: 1.45rem;
      font-weight: 600;
    }

    p {
      color: var(--muted);
    }

    .lead {
      max-width: 680px;
      font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      min-height: 54px;
      padding: 0 25px;
      border: 1px solid transparent;
      border-radius: 999px;
      font-size: 0.93rem;
      font-weight: 700;
      transition: transform 0.25s ease, background 0.25s ease, color 0.25s ease, border-color 0.25s ease;
    }

    .btn:hover {
      transform: translateY(-2px);
    }

    .btn-primary {
      background: var(--gold);
      color: var(--ink);
      box-shadow: 0 12px 30px rgba(245, 184, 75, 0.3);
    }

    .btn-primary:hover {
      background: #ffc65e;
    }

    .btn-dark {
      background: var(--ink);
      color: var(--white);
    }

    .btn-outline-light {
      border-color: rgba(255, 255, 255, 0.52);
      color: var(--white);
      backdrop-filter: blur(8px);
    }

    .btn-outline-light:hover {
      border-color: var(--white);
      background: var(--white);
      color: var(--ink);
    }

    .arrow {
      display: inline-block;
      transition: transform 0.25s ease;
    }

    .btn:hover .arrow {
      transform: translateX(4px);
    }

    .topbar {
      position: relative;
      z-index: 1001;
      background: var(--ink);
      color: var(--white);
      font-size: 0.94rem;
      font-weight: 700;
      letter-spacing: 0.012em;
    }

    .topbar-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: 38px;
    }

    .topbar-links,
    .topbar-note {
      display: flex;
      align-items: center;
      gap: 22px;
    }

    .topbar a:hover {
      color: var(--gold);
    }

    .site-header {
      position: absolute;
      top: 38px;
      left: 0;
      z-index: 1000;
      width: 100%;
      border-bottom: 1px solid rgba(255, 255, 255, 0.14);
      background: linear-gradient(180deg, rgba(7, 20, 34, 0.66), rgba(7, 20, 34, 0.34));
      color: var(--white);
      text-shadow: 0 2px 12px rgba(0, 0, 0, 0.72);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
      transition: background 0.25s ease, box-shadow 0.25s ease, color 0.25s ease, transform 0.25s ease;
    }

    .site-header.scrolled {
      position: fixed;
      top: 0;
      border-bottom-color: rgba(51, 102, 153, 0.14);
      background: rgba(255, 253, 248, 0.96);
      color: var(--ink);
      text-shadow: none;
      box-shadow: 0 10px 35px rgba(17, 17, 15, 0.08);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
    }

    .nav-wrap {
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: 86px;
    }

    .brand {
      display: inline-flex;
      align-items: center;
      min-width: max-content;
    }

    .site-logo {
      width: clamp(195px, 19vw, 260px);
      height: auto;
      max-height: 70px;
      object-fit: contain;
      filter: drop-shadow(0 3px 10px rgba(0, 0, 0, 0.58));
    }

    .site-header.scrolled .site-logo {
      filter: drop-shadow(0 2px 5px rgba(17, 17, 15, 0.12));
    }

    .desktop-nav {
      display: flex;
      align-items: center;
      gap: 34px;
      margin-left: auto;
      margin-right: 30px;
      font-size: 1.05rem;
      font-weight: 700;
      letter-spacing: 0.012em;
    }

    .desktop-nav a {
      position: relative;
      padding: 10px 1px;
    }

    .desktop-nav a::after {
      position: absolute;
      right: 0;
      bottom: -7px;
      left: 0;
      height: 2px;
      background: var(--gold);
      content: "";
      transform: scaleX(0);
      transform-origin: right;
      transition: transform 0.25s ease;
    }

    .desktop-nav a:hover::after {
      transform: scaleX(1);
      transform-origin: left;
    }

    .header-cta {
      min-height: 46px;
      padding-inline: 20px;
    }

    .menu-toggle {
      display: none;
      width: 46px;
      height: 46px;
      border-radius: 50%;
      background: var(--gold);
      color: var(--ink);
    }

    .menu-toggle span,
    .menu-toggle span::before,
    .menu-toggle span::after {
      display: block;
      width: 19px;
      height: 2px;
      margin: auto;
      background: currentColor;
      content: "";
      transition: transform 0.25s ease, opacity 0.25s ease;
    }

    .menu-toggle span {
      position: relative;
    }

    .menu-toggle span::before {
      position: absolute;
      top: -6px;
    }

    .menu-toggle span::after {
      position: absolute;
      top: 6px;
    }

    .menu-toggle.active span {
      background: transparent;
    }

    .menu-toggle.active span::before {
      top: 0;
      transform: rotate(45deg);
    }

    .menu-toggle.active span::after {
      top: 0;
      transform: rotate(-45deg);
    }

    .mobile-menu {
      position: fixed;
      inset: 0;
      z-index: 999;
      display: grid;
      align-content: center;
      padding: 110px 28px 40px;
      background: var(--ink);
      color: var(--white);
      opacity: 0;
      pointer-events: none;
      transform: translateY(-15px);
      transition: opacity 0.25s ease, transform 0.25s ease;
    }

    .mobile-menu.open {
      opacity: 1;
      pointer-events: auto;
      transform: translateY(0);
    }

    .mobile-menu nav {
      display: grid;
      gap: 17px;
    }

    .mobile-menu nav a {
      padding-block: 9px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.12);
      font-family: "Playfair Display", serif;
      font-size: clamp(2rem, 10vw, 3.2rem);
    }

    .mobile-contact {
      display: grid;
      gap: 8px;
      margin-top: 38px;
      color: rgba(255, 255, 255, 0.72);
    }

    .hero {
      position: relative;
      display: flex;
      min-height: 860px;
      align-items: flex-end;
      overflow: hidden;
      background: var(--charcoal) url("hero-poster.jpg") center center / cover no-repeat;
      isolation: isolate;
    }

    .hero-video {
      position: absolute;
      inset: 0;
      z-index: -3;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      transform: scale(1.03);
      animation: heroZoom 16s ease-out forwards;
    }

    .hero::before {
      position: absolute;
      inset: 0;
      z-index: -2;
      background:
        linear-gradient(90deg, rgba(10, 10, 8, 0.88) 0%, rgba(10, 10, 8, 0.54) 48%, rgba(10, 10, 8, 0.2) 100%),
        linear-gradient(180deg, rgba(10, 10, 8, 0.16), rgba(10, 10, 8, 0.5));
      content: "";
      pointer-events: none;
    }

    .hero::after {
      position: absolute;
      right: -100px;
      bottom: -155px;
      z-index: -1;
      width: 520px;
      height: 520px;
      border: 1px solid rgba(245, 184, 75, 0.28);
      border-radius: 50%;
      content: "";
      box-shadow: 0 0 0 70px rgba(245, 184, 75, 0.055), 0 0 0 140px rgba(245, 184, 75, 0.035);
      pointer-events: none;
    }

    @keyframes heroZoom {
      to { transform: scale(1); }
    }

    .hero-inner {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 280px;
      gap: 50px;
      align-items: end;
      padding-top: 190px;
      padding-bottom: 95px;
    }

    .hero-kicker {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 24px;
      color: var(--gold);
      font-size: 0.77rem;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
    }

    .hero-kicker::before {
      width: 38px;
      height: 2px;
      background: currentColor;
      content: "";
    }

    .hero-copy > p {
      max-width: 700px;
      margin-top: 25px;
      color: rgba(255, 255, 255, 0.76);
      font-size: clamp(1.06rem, 1.5vw, 1.25rem);
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      margin-top: 36px;
    }

    .hero-trust {
      padding: 26px;
      border: 1px solid rgba(255, 255, 255, 0.18);
      border-radius: var(--radius-md);
      background: rgba(12, 12, 10, 0.48);
      color: var(--white);
      backdrop-filter: blur(14px);
    }

    .hero-trust strong {
      display: block;
      color: var(--gold);
      font-family: "Playfair Display", serif;
      font-size: 2.2rem;
      line-height: 1;
    }

    .hero-trust span {
      display: block;
      margin-top: 9px;
      color: rgba(255, 255, 255, 0.75);
      font-size: 0.89rem;
    }

    .hero-trust hr {
      margin: 22px 0;
      border: 0;
      border-top: 1px solid rgba(255, 255, 255, 0.14);
    }

    .trust-strip {
      position: relative;
      z-index: 4;
      margin-top: -28px;
    }

    .trust-strip-inner {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      border-radius: 20px;
      background: var(--white);
      box-shadow: var(--shadow-lg);
      overflow: hidden;
    }

    .trust-item {
      display: flex;
      min-height: 105px;
      align-items: center;
      justify-content: center;
      gap: 12px;
      padding: 22px;
      border-right: 1px solid var(--line);
      text-align: center;
      font-size: 0.85rem;
      font-weight: 700;
    }

    .trust-item:last-child {
      border-right: 0;
    }

    .trust-icon {
      display: grid;
      width: 36px;
      height: 36px;
      flex: 0 0 auto;
      place-items: center;
      border-radius: 50%;
      background: var(--gold-pale);
      color: var(--gold-deep);
      font-size: 1rem;
    }

    .intro-grid {
      display: grid;
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
      gap: clamp(50px, 8vw, 105px);
      align-items: center;
    }

    .image-composition {
      position: relative;
      min-height: 650px;
    }

    .image-main {
      position: absolute;
      inset: 0 70px 70px 0;
      overflow: hidden;
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-lg);
    }

    .image-main img,
    .image-small img {
      display: block;
      width: 100%;
      height: 100%;
      max-width: none;
      object-fit: cover;
    }

    .image-main img[src$="neighborhood.jpg"] {
      object-position: center center;
    }

    .image-small img[src$="chairs.jpg"] {
      object-position: center 45%;
    }

    .image-small {
      position: absolute;
      right: 0;
      bottom: 0;
      width: 48%;
      height: 42%;
      overflow: hidden;
      border: 10px solid var(--cream);
      border-radius: 28px;
      box-shadow: var(--shadow-sm);
    }

    .experience-badge {
      position: absolute;
      top: 42px;
      right: 22px;
      display: grid;
      width: 150px;
      height: 150px;
      place-items: center;
      border-radius: 50%;
      background: var(--gold);
      color: var(--ink);
      text-align: center;
      transform: rotate(7deg);
      box-shadow: var(--shadow-sm);
    }

    .experience-badge strong {
      display: block;
      font-family: "Playfair Display", serif;
      font-size: 2.6rem;
      line-height: 0.9;
    }

    .experience-badge span {
      display: block;
      margin-top: 5px;
      font-size: 0.7rem;
      font-weight: 800;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .intro-copy h2 {
      max-width: 700px;
    }

    .intro-copy .lead {
      margin-top: 25px;
    }

    .feature-list {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 15px 26px;
      margin: 34px 0;
    }

    .feature-list li {
      display: flex;
      align-items: center;
      gap: 10px;
      list-style: none;
      font-size: 0.94rem;
      font-weight: 600;
    }

    .feature-list li::before {
      display: grid;
      width: 24px;
      height: 24px;
      flex: 0 0 auto;
      place-items: center;
      border-radius: 50%;
      background: var(--gold-pale);
      color: var(--gold-deep);
      content: "✓";
      font-size: 0.75rem;
      font-weight: 900;
    }

    .principal-agent {
      position: relative;
      overflow: hidden;
      background: var(--sand);
    }

    .principal-agent::before {
      position: absolute;
      top: -240px;
      right: -210px;
      width: 520px;
      height: 520px;
      border: 1px solid rgba(51, 102, 153, 0.12);
      border-radius: 50%;
      content: "";
      box-shadow: 0 0 0 78px rgba(51, 102, 153, 0.035), 0 0 0 156px rgba(51, 102, 153, 0.02);
      pointer-events: none;
    }

    .agent-grid {
      position: relative;
      display: grid;
      grid-template-columns: 480px minmax(0, 1fr);
      gap: clamp(48px, 8vw, 105px);
      align-items: center;
    }

    .agent-photo-wrap {
      position: relative;
      width: 480px;
      margin-inline: auto;
    }

    .agent-photo-placeholder {
      position: relative;
      display: block;
      width: 100%;
      max-width: 100%;
      height: auto;
      aspect-ratio: auto;
      object-fit: contain;
      overflow: hidden;
      border: 10px solid var(--white);
      border-radius: var(--radius-lg);
      background: var(--white);
      box-shadow: var(--shadow-lg);
    }

    .agent-photo-placeholder::before {
      position: absolute;
      top: 18%;
      width: 31%;
      aspect-ratio: 1;
      border: 3px solid rgba(255, 255, 255, 0.66);
      border-radius: 50%;
      content: "";
    }

    .agent-photo-placeholder::after {
      position: absolute;
      bottom: 16%;
      width: 62%;
      height: 39%;
      border: 3px solid rgba(255, 255, 255, 0.66);
      border-bottom: 0;
      border-radius: 50% 50% 0 0;
      content: "";
    }

    .agent-photo-placeholder span {
      position: absolute;
      right: 22px;
      bottom: 22px;
      left: 22px;
      z-index: 1;
      padding: 13px 16px;
      border: 1px solid rgba(255, 255, 255, 0.22);
      border-radius: 14px;
      background: rgba(17, 17, 15, 0.42);
      color: var(--white);
      font-size: 0.76rem;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-align: center;
      text-transform: uppercase;
      backdrop-filter: blur(10px);
    }

    .agent-role-card {
      position: absolute;
      right: -24px;
      bottom: 38px;
      z-index: 2;
      max-width: 190px;
      padding: 20px 22px;
      border-radius: 18px;
      background: var(--gold);
      color: var(--ink);
      box-shadow: var(--shadow-sm);
    }

    .agent-role-card strong,
    .agent-role-card span {
      display: block;
    }

    .agent-role-card strong {
      font-family: "Playfair Display", serif;
      font-size: 1.32rem;
      line-height: 1.15;
    }

    .agent-role-card span {
      margin-top: 6px;
      font-size: 0.72rem;
      font-weight: 800;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .agent-copy {
      max-width: 720px;
    }

    .agent-copy h2 {
      color: var(--ink);
    }

    .agent-copy .lead {
      margin-top: 24px;
      color: var(--charcoal);
    }

    .agent-copy p:not(.lead) {
      margin-top: 19px;
    }

    .agent-values {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 30px;
    }

    .agent-values span {
      padding: 9px 14px;
      border: 1px solid rgba(51, 102, 153, 0.16);
      border-radius: 999px;
      background: var(--white);
      color: var(--ink);
      font-size: 0.78rem;
      font-weight: 800;
      letter-spacing: 0.04em;
      box-shadow: 0 8px 22px rgba(25, 22, 15, 0.045);
    }

    .agent-copy .btn {
      margin-top: 32px;
    }

    .services {
      background: var(--sand);
    }

    .section-heading-row {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 40px;
      margin-bottom: 50px;
    }

    .section-heading-row .lead {
      max-width: 520px;
    }

    .service-tabs {
      display: inline-flex;
      gap: 6px;
      padding: 6px;
      border-radius: 999px;
      background: var(--white);
      box-shadow: var(--shadow-sm);
    }

    .service-tab {
      min-height: 46px;
      padding: 0 22px;
      border-radius: 999px;
      background: transparent;
      color: var(--muted);
      font-weight: 700;
    }

    .service-tab.active {
      background: var(--ink);
      color: var(--white);
    }

    .services-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 18px;
    }

    .service-card {
      position: relative;
      display: flex;
      min-height: 305px;
      flex-direction: column;
      justify-content: space-between;
      padding: 30px;
      border: 1px solid transparent;
      border-radius: var(--radius-md);
      background: var(--white);
      box-shadow: 0 10px 35px rgba(20, 18, 12, 0.04);
      transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    }

    .service-card:hover {
      border-color: rgba(245, 184, 75, 0.7);
      box-shadow: var(--shadow-sm);
      transform: translateY(-7px);
    }

    .service-card[hidden] {
      display: none;
    }

    .service-icon {
      display: grid;
      width: 58px;
      height: 58px;
      place-items: center;
      border-radius: 18px;
      background: var(--gold-pale);
      color: var(--gold-deep);
      font-size: 1.45rem;
    }

    .service-card h3 {
      margin-top: 42px;
    }

    .service-card p {
      margin-top: 12px;
      font-size: 0.91rem;
    }

    .service-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-top: 24px;
      color: var(--ink);
      font-size: 0.82rem;
      font-weight: 800;
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }

    .process {
      background: var(--ink);
      color: var(--white);
    }

    .process .section-kicker,
    .process p {
      color: rgba(255, 255, 255, 0.66);
    }

    .process .section-kicker {
      color: var(--gold);
    }

    .process h2 {
      color: var(--white);
    }

    .process-grid {
      position: relative;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 30px;
      margin-top: 65px;
    }

    .process-grid::before {
      position: absolute;
      top: 37px;
      right: 8%;
      left: 8%;
      height: 1px;
      background: rgba(255, 255, 255, 0.15);
      content: "";
